{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ibexx_itc:crimson_embers",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 32,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1.0
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, 2, 0],
				"half_dimensions": [14, 5, 14],
				"direction": [0, 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(2.5, 4.5)"
			},
			"minecraft:particle_initial_speed": "math.random(0.15, 0.5)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"math.sin(variable.particle_age * 95 + variable.particle_random_1 * 360) * 0.6",
					"variable.particle_random_2 > 0.4 ? 0.35 : -0.3",
					"math.cos(variable.particle_age * 85 + variable.particle_random_2 * 360) * 0.6"
				],
				"linear_drag_coefficient": 2.0
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.03 + variable.particle_random_1 * 0.025",
					"0.03 + variable.particle_random_1 * 0.025"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [44, 29],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_age / variable.particle_lifetime",
					"gradient": {
						"0.0": "#003d1008",
						"0.25": "#cc8c2412",
						"0.65": "#d854140a",
						"1.0": "#00240804"
					}
				}
			}
		}
	}
}