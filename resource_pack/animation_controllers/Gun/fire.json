{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.gun_fire": {
      "states": {
          "default": {
            "transitions": [
              { "fire": "query.property('property:is_shooting') && !query.property('property:start_gun') && query.property('property:has_ammo') && q.variant != 4" }
            ]
          },
          "fire": {
            "animations": [
              "fire_anim"
            ],
            "transitions": [
              { "default": "!query.property('property:is_shooting') || !query.property('property:has_ammo')" }
            ],
            "blend_transition": 0.3
          }
      }
  }
  }
}


