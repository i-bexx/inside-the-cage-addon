{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.hand": {
      "states": {
          "default": {
            "animations": [ "hands" ],
            "transitions": [
              { "attack": "variable.player_attack" },
              { "swim": "q.is_alive && q.is_swimming" },
              { "walk": "variable.player_walk"},
              { "move_right": "variable.player_move_right" },
              { "move_left": "variable.player_move_left" },
              { "run": "variable.player_run" },
              { "despawn_right_but_left_empty": "variable.despawn_right_but_left_empty" },
              { "despawn_left_but_right_empty": "variable.despawn_left_but_right_empty" },
              { "starting_gun": "variable.gun_starting" },
              { "holding_gun": "variable.gun_holding" },
              { "starting_knife": "q.is_alive && query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" },
              { "toxic_bomb_pick_up": "q.is_alive && query.is_item_name_any('slot.weapon.mainhand', 0, 'game:toxic_bomb')" },
              { "kit_pick_up": "q.is_alive && query.is_item_name_any('slot.weapon.mainhand', 0, 'game:kit')" }
            ],
            "blend_transition": 0.3
          },
          "attack": {
            "animations": [ "attack" ],
            "transitions": [
              { "default": "q.all_animations_finished" }
            ],
            "blend_transition": 0.3
          },
          "swim": {
            "animations": [ "swim" ],
            "transitions": [
              { "default": "!(q.is_swimming)" },
              { "attack": "(variable.attack_time > 0 && variable.item_use_normalized <= 0)" }
            ],
            "blend_transition": 0.9
          },
          "walk": {
            "animations": [ "walk" ],
            "transitions": [
              { "default": "!(query.is_moving && query.is_on_ground && query.ground_speed > 4)" },
              { "swim": "q.is_swimming" },
              { "move_right": "variable.player_move_right" },
              { "move_left": "variable.player_move_left" },
              { "run": "variable.player_run" },
              { "attack": "variable.player_attack" },
              { "despawn_right_but_left_empty": "variable.despawn_right_but_left_empty" },
              { "despawn_left_but_right_empty": "variable.despawn_left_but_right_empty" },
              { "starting_gun": "variable.gun_starting" },
              { "holding_gun": "variable.gun_holding" },
              { "starting_knife": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" },
              { "toxic_bomb_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:toxic_bomb')" },
              { "kit_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:kit')" }
            ],
            "blend_transition": 0.3
          },
          "move_right": {
            "animations": [ "move_right" ],
            "transitions": [
              { "default": "!(query.is_moving && query.is_on_ground) && !q.is_item_name_any('slot.armor.legs', 'p:move_right')" },
              { "swim": "q.is_swimming" },
              { "walk": "variable.player_walk"},
              { "move_left": "variable.player_move_left" },
              { "run": "variable.player_run" },
              { "attack": "variable.player_attack" },
              { "despawn_right_but_left_empty": "variable.despawn_right_but_left_empty" },
              { "despawn_left_but_right_empty": "variable.despawn_left_but_right_empty" },
              { "starting_gun": "variable.gun_starting" },
              { "holding_gun": "variable.gun_holding" },
              { "starting_knife": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" },
              { "toxic_bomb_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:toxic_bomb')" },
              { "kit_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:kit')" }
            ],
            "blend_transition": 0.3
          },
          "move_left": {
            "animations": [ "move_left" ],
            "transitions": [
              { "default": "!(query.is_moving && query.is_on_ground) && !q.is_item_name_any('slot.armor.legs', 0, 'p:move_left')" },
              { "swim": "q.is_swimming" },
              { "walk": "variable.player_walk"},
              { "move_right": "variable.player_move_right" },
              { "run": "variable.player_run" },
              { "attack": "variable.player_attack" },
              { "despawn_right_but_left_empty": "variable.despawn_right_but_left_empty" },
              { "despawn_left_but_right_empty": "variable.despawn_left_but_right_empty" },
              { "starting_gun": "variable.gun_starting" },
              { "holding_gun": "variable.gun_holding" },
              { "starting_knife": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" },
              { "toxic_bomb_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:toxic_bomb')" },
              { "kit_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:kit')" }
            ],
            "blend_transition": 0.3
          },
          "run": {
            "animations": [ "run" ],
            "transitions": [
              { "default": "!(query.is_moving && query.is_on_ground && query.ground_speed > 5) || query.is_in_water" },
              { "swim": "q.is_swimming" },
              { "attack": "variable.player_attack" },
              { "despawn_right_but_left_empty": "variable.despawn_right_but_left_empty" },
              { "despawn_left_but_right_empty": "variable.despawn_left_but_right_empty" },
              { "starting_gun": "variable.gun_starting" },
              { "holding_gun": "variable.gun_holding" },
              { "starting_knife": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" },
              { "toxic_bomb_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:toxic_bomb')" },
              { "kit_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:kit')" }
            ],
            "blend_transition": 0.3
          },
          "still_right_arm": {
            "animations": [ "still_right_arm" ],
            "transitions": [
              { "despawn_right_but_left_not_empty": "!query.is_item_name_any('slot.weapon.mainhand', 0, '')" },
              { "default": "query.is_item_name_any('slot.weapon.offhand', 0, '')" }
            ],
            "blend_transition": 0.3
          },
          "still_left_arm": {
            "animations": [ "still_left_arm" ],
            "transitions": [
              { "despawn_left_but_right_not_empty": "!query.is_item_name_any('slot.weapon.offhand', 0, '')" },
              { "default": "query.is_item_name_any('slot.weapon.mainhand', 0, '')" }
            ],
            "blend_transition": 0.3
          },
          "despawn_left_but_right_empty": {
            "animations": [ "despawn_left_but_right_empty" ],
            "transitions": [
              { "still_right_arm": "query.all_animations_finished" },
              { "starting_gun": "variable.gun_starting" },
              { "holding_gun": "variable.gun_holding" },
              { "starting_knife": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" },
              { "toxic_bomb_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:toxic_bomb')" },
              { "kit_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:kit')" },
              { "despawn_right_but_left_not_empty": "!query.is_item_name_any('slot.weapon.mainhand', 0, '')" },
              { "respawn_left_but_right_empty": "query.is_item_name_any('slot.weapon.offhand', 0, '')" }
            ],
            "blend_transition": 0.3
          },
          "despawn_right_but_left_empty": {
            "animations": [ "despawn_right_but_left_empty" ],
            "transitions": [
              { "still_left_arm": "query.all_animations_finished" },
              { "starting_gun": "variable.gun_starting" },
              { "holding_gun": "variable.gun_holding" },
              { "starting_knife": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" },
              { "toxic_bomb_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:toxic_bomb')" },
              { "kit_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:kit')" },
              { "despawn_left_but_right_not_empty": "!query.is_item_name_any('slot.weapon.offhand', 0, '')" },
              { "respawn_right_but_left_empty": "query.is_item_name_any('slot.weapon.mainhand', 0, '')" }
            ],
            "blend_transition": 0.3
          },
          "despawn_right_but_left_not_empty": {
            "animations": [ "despawn_right_but_left_not_empty" ],
            "transitions": [
              { "starting_gun": "variable.gun_starting" },
              { "holding_gun": "variable.gun_holding" },
              { "starting_knife": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" },
              { "toxic_bomb_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:toxic_bomb')" },
              { "kit_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:kit')" },
              { "respawn_right_but_left_not_empty": "query.is_item_name_any('slot.weapon.mainhand', 0, '')" },
              { "respawn_left_but_right_not_empty": "query.is_item_name_any('slot.weapon.offhand', 0, '')" }
            ],
            "blend_transition": 0.3
          },
          "despawn_left_but_right_not_empty": {
            "animations": [ "despawn_left_but_right_not_empty" ],
            "transitions": [
              { "starting_gun": "variable.gun_starting" },
              { "holding_gun": "variable.gun_holding" },
              { "starting_knife": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" },
              { "toxic_bomb_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:toxic_bomb')" },
              { "kit_pick_up": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:kit')" },
              { "respawn_left_but_right_not_empty": "query.is_item_name_any('slot.weapon.offhand', 0, '')" },
              { "respawn_right_but_left_not_empty": "query.is_item_name_any('slot.weapon.mainhand', 0, '')" }
            ],
            "blend_transition": 0.3
          },
          "respawn_right_but_left_empty": {
            "animations": [ "respawn_right_but_left_empty" ],
            "transitions": [
              { "despawn_right_but_left_empty": "!query.is_item_name_any('slot.weapon.mainhand', 0, '')" },
              { "default": "query.is_item_name_any('slot.weapon.offhand', 0, '')" }
            ],
            "blend_transition": 0.3
          },
          "respawn_left_but_right_empty": {
            "animations": [ "respawn_left_but_right_empty" ],
            "transitions": [
              { "despawn_left_but_right_empty": "!query.is_item_name_any('slot.weapon.offhand', 0, '')" },
              { "default": "query.is_item_name_any('slot.weapon.mainhand', 0, '')" }
            ],
            "blend_transition": 0.3
          },
          "respawn_right_but_left_not_empty": {
            "animations": [ "respawn_right_but_left_not_empty" ],
            "transitions": [
              { "despawn_right_but_left_not_empty": "!query.is_item_name_any('slot.weapon.mainhand', 0, '')" },
              { "respawn_left_but_right_empty": "query.is_item_name_any('slot.weapon.offhand', 0, '')" }
            ],
            "blend_transition": 0.3
          },
          "respawn_left_but_right_not_empty": {
            "animations": [ "respawn_left_but_right_not_empty" ],
            "transitions": [
              { "despawn_left_but_right_not_empty": "!query.is_item_name_any('slot.weapon.offhand', 0, '')" },
              { "respawn_right_but_left_empty": "query.is_item_name_any('slot.weapon.mainhand', 0, '')" }
            ],
            "blend_transition": 0.3
          },
          "starting_gun": {
            "animations": [ "starting_gun" ],
            "transitions": [
              { "holding_gun": "!query.property('property:start_gun') && query.all_animations_finished" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:gun')" }
            ],
            "blend_transition": 0.3
          },
          "holding_gun": {
            "animations": [ "holding_gun" ],
            "transitions": [
              { "starting_gun": "variable.gun_starting" },
              { "walking_gun": "variable.gun_walking" },
              { "running_gun": "variable.gun_running" },
              { "shooting_gun": "variable.gun_shooting" },
              { "aiming_gun": "query.is_sneaking" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:gun')" }
            ],
            "blend_transition": 0.3
          },
          "walking_gun": {
            "animations": [ "walking_gun" ],
            "transitions": [
              { "starting_gun": "variable.gun_starting" },
              { "holding_gun": "!query.is_moving || !query.is_on_ground || query.is_in_water || query.ground_speed <= 4" },
              { "running_gun": "variable.gun_running" },
              { "aiming_gun": "query.is_sneaking" },
              { "shooting_gun": "variable.gun_shooting" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:gun')" }
            ],
            "blend_transition": 0.3
          },
          "running_gun": {
            "animations": [ "running_gun" ],
            "transitions": [
              { "starting_gun": "variable.gun_starting" },
              { "holding_gun": "!query.is_moving || !query.is_on_ground || query.is_in_water || query.ground_speed <= 5" },
              { "shooting_gun": "variable.gun_shooting" },
              { "aiming_gun": "query.is_sneaking" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:gun')" }
            ],
            "blend_transition": 0.3
          },
          "shooting_gun": {
            "animations": [ "shooting_gun" ],
            "transitions": [
              { "holding_gun": "(!q.property('property:has_ammo') || !q.property('property:is_shooting') || q.variant != 1) && query.all_animations_finished" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:gun')" }
            ],
            "blend_transition": 0.3
          },
          "aiming_gun": {
            "animations": [ "aiming_gun" ],
            "transitions": [
              { "holding_gun": "!query.is_sneaking" },
              { "shoot_aiming": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:gun') && query.is_sneaking && q.property('property:has_ammo') && q.property('property:is_shooting') && q.variant == 1" },
              { "aiming_gun_still": "query.is_sneaking && query.all_animations_finished" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:gun')" }
            ],
            "blend_transition": 0.3
          },
          "aiming_gun_still": {
            "animations": [ "aiming_gun_still" ],
            "transitions": [
              { "holding_gun": "!query.is_sneaking" },
              { "shoot_aiming": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:gun') && query.is_sneaking && q.property('property:has_ammo') && q.property('property:is_shooting') && q.variant != 2" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:gun')" }
            ],
            "blend_transition": 0.3
          },
          "shoot_aiming": {
            "animations": [ "shoot_aiming" ],
            "transitions": [
              { "aiming_gun": "!q.property('property:has_ammo') || !q.property('property:is_shooting') || q.variant != 1" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:gun')" }
            ],
            "blend_transition": 0.1
          },
          "starting_knife": {
            "animations": [ "starting_knife" ],
            "transitions": [
              { "holding_knife": "query.all_animations_finished" },
              { "attacking_knife_first": "variable.knife_attack_first" },
              { "attacking_knife_second": "variable.knife_attack_second" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" }
            ]
          },
          "holding_knife": {
            "animations": [ "holding_knife" ],
            "transitions": [
              { "attacking_knife_first": "variable.knife_attack_first" },
              { "attacking_knife_second": "variable.knife_attack_second" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" }
            ],
            "blend_transition": 0.3
          },
          "attacking_knife_first": {
            "animations": [ "attacking_knife_first" ],
            "transitions": [
              { "attack_finishing_knife": "query.all_animations_finished && query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" }
            ]
          },
          "attacking_knife_second": {
            "animations": [ "attacking_knife_second" ],
            "transitions": [
              { "attack_finishing_knife": "query.all_animations_finished && query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" }
            ]
          },
          "attack_finishing_knife": {
            "on_entry": [ "variable.knife_attack_index = math.random(0, 1);" ],
            "animations": [ "attack_finishing_knife" ],
            "transitions": [
              { "holding_knife": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife') && query.all_animations_finished" },
              { "attacking_knife_first": "variable.knife_attack_first" },
              { "attacking_knife_second": "variable.knife_attack_second" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:knife')" }
            ]
          },
          "toxic_bomb_pick_up": {
            "animations": [ "toxic_bomb_pick_up" ],
            "transitions": [
              { "toxic_bomb_hold": "variable.toxic_bomb_hold"},
              { "toxic_bomb_use": "variable.toxic_bomb_use" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:toxic_bomb')" }
            ],
            "blend_transition": 0.3
          },
          "toxic_bomb_hold": {
            "animations": [ "toxic_bomb_hold" ],
            "transitions": [
              { "toxic_bomb_use": "variable.toxic_bomb_use" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:toxic_bomb')" }
            ],
            "blend_transition": 0.3
          },
          "toxic_bomb_use": {
            "animations": [ "toxic_bomb_use" ],
            "transitions": [
              { "toxic_bomb_hold": "variable.toxic_bomb_hold" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:toxic_bomb')" }
            ],
            "blend_transition": 0.3
          },
          "kit_pick_up": {
            "animations": [ "kit_pick_up" ],
            "transitions": [
              { "holding_kit": "query.is_item_name_any('slot.weapon.mainhand', 0, 'game:kit') && query.all_animations_finished" },
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:kit')" }
            ],
            "blend_transition": 0.3
          },
          "holding_kit": {
            "animations": [ "holding_kit" ],
            "transitions": [
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:kit')" }
            ],
            "blend_transition": 0.3
          }
      }
    }
  }
}


