{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.battery": {
      "states": {
        "default": {
          "transitions": [
            { "battery_increase_4": "q.is_alive && q.is_item_name_any('slot.armor.head', 'battery:increase4')" },
            { "battery_decrease_1": "q.is_alive && q.is_item_name_any('slot.armor.head', 'battery:decrease1')" }
          ]
        },

        "battery_increase_4": {
          "animations": ["battery_increase_4"],
          "transitions": [
            { "battery_increase_3": "q.is_item_name_any('slot.armor.head', 'battery:increase3')" },
            { "battery_decrease_4": "q.is_item_name_any('slot.armor.head', 'battery:decrease4')" },
            { "default": "query.mark_variant < 555" }
          ]
        },
        "battery_increase_3": {
          "animations": ["battery_increase_3"],
          "transitions": [
            { "battery_increase_2": "q.is_item_name_any('slot.armor.head', 'battery:increase2')" },
            { "battery_decrease_3": "q.is_item_name_any('slot.armor.head', 'battery:decrease3')" },
            { "default": "query.mark_variant < 555" }
          ]
        },
        "battery_increase_2": {
          "animations": ["battery_increase_2"],
          "transitions": [
            { "battery_increase_1": "q.is_item_name_any('slot.armor.head', 'battery:increase1')" },
            { "battery_decrease_2": "q.is_item_name_any('slot.armor.head', 'battery:decrease2')" },
            { "default": "query.mark_variant < 555" }
          ]
        },
        "battery_increase_1": {
          "animations": ["battery_increase_1"],
          "transitions": [
            { "battery_decrease_1": "q.is_item_name_any('slot.armor.head', 'battery:decrease1')" },
            { "default": "query.mark_variant < 555" }
          ]
        },

        "battery_decrease_1": {
          "animations": ["battery_decrease_1"],
          "transitions": [
            { "battery_decrease_2": "q.is_item_name_any('slot.armor.head', 'battery:decrease2')" },
            { "battery_increase_1": "q.is_item_name_any('slot.armor.head', 'battery:increase1')" },
            { "default": "query.mark_variant < 555" }
          ]
        },
        "battery_decrease_2": {
          "animations": ["battery_decrease_2"],
          "transitions": [
            { "battery_decrease_3": "q.is_item_name_any('slot.armor.head', 'battery:decrease3')" },
            { "battery_increase_2": "q.is_item_name_any('slot.armor.head', 'battery:increase2')" },
            { "default": "query.mark_variant < 555" }
          ]
        },
        "battery_decrease_3": {
          "animations": ["battery_decrease_3"],
          "transitions": [
            { "battery_decrease_4": "q.is_item_name_any('slot.armor.head', 'battery:decrease4')" },
            { "battery_increase_3": "q.is_item_name_any('slot.armor.head', 'battery:increase3')" },
            { "default": "query.mark_variant < 555" }
          ]
        },
        "battery_decrease_4": {
          "animations": ["battery_decrease_4"],
          "transitions": [
            { "battery_increase_4": "q.is_item_name_any('slot.armor.head', 'battery:increase4')" },
            { "default": "query.mark_variant < 555" }
          ]
        }
      }
    }
  }
}