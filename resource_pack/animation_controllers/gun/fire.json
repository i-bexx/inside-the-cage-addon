{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ibexx_itc.gun_fire": {
      "states": {
          "default": {
            "transitions": [
              { "fire": "query.property('ibexx_itc:is_shooting') && !query.property('ibexx_itc:start_gun') && query.property('ibexx_itc:has_ammo')" }
            ]
          },
          "fire": {
            "animations": [
              "fire_anim"
            ],
            "transitions": [
              { "default": "!query.property('ibexx_itc:is_shooting') && q.variant != 1" }
            ],
            "blend_transition": 0.3
          }
      }
  }
  }
}


