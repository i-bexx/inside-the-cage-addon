{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.gun_chamber": {
      "states": {
          "default": {
            "transitions": [
              { "chamber": "context.is_first_person && query.is_item_name_any('slot.weapon.mainhand', 0, 'game:gun') && query.property('property:start_gun')" }
            ]
          },
          "chamber": {
            "animations": [ "chamber_anim" ],
            "transitions": [
              { "default": "(!query.is_item_name_any('slot.weapon.mainhand', 0, 'game:gun') || !query.property('property:start_gun')) && query.all_animations_finished" }
            ],
            "blend_transition": 0.3
          }
      }
  }
  }
}