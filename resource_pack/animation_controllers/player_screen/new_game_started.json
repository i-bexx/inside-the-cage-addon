{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.new_game_started": {
      "states": {
        "default": {
          "transitions": [
            { "dialog": "q.is_alive && query.mark_variant == 2" }
          ]
        },
        "dialog": {
          "animations": [ "new_game_started_dialog_anim" ],
          "transitions": [
            { "spin": "q.all_animations_finished" },
            { "default": "query.mark_variant != 2" }
          ]
        },
        "spin": {
          "animations": [ "new_game_started_spin_anim" ],
          "transitions": [
            { "default": "query.mark_variant != 2" }
          ]
        }
      }
    }
  }
}
