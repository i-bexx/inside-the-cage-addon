{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ibexx_itc.battery": {
      "states": {
        "default": {
          "transitions": [
            { "battery_increase_4": "q.is_alive && q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_increase4')" },
            { "battery_decrease_1": "q.is_alive && q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_decrease1')" }
          ]
        },

        "battery_increase_4": {
          "animations": ["battery_increase_4"],
          "transitions": [
            { "battery_increase_3": "q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_increase3')" },
            { "battery_decrease_4": "q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_decrease4')" },
            { "default": "query.mark_variant < 555 && query.mark_variant != 20" }
          ]
        },
        "battery_increase_3": {
          "animations": ["battery_increase_3"],
          "transitions": [
            { "battery_increase_2": "q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_increase2')" },
            { "battery_decrease_3": "q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_decrease3')" },
            { "default": "query.mark_variant < 555 && query.mark_variant != 20" }
          ]
        },
        "battery_increase_2": {
          "animations": ["battery_increase_2"],
          "transitions": [
            { "battery_increase_1": "q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_increase1')" },
            { "battery_decrease_2": "q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_decrease2')" },
            { "default": "query.mark_variant < 555 && query.mark_variant != 20" }
          ]
        },
        "battery_increase_1": {
          "animations": ["battery_increase_1"],
          "transitions": [
            { "battery_decrease_1": "q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_decrease1')" },
            { "default": "query.mark_variant < 555 && query.mark_variant != 20" }
          ]
        },

        "battery_decrease_1": {
          "animations": ["battery_decrease_1"],
          "transitions": [
            { "battery_decrease_2": "q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_decrease2')" },
            { "battery_increase_1": "q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_increase1')" },
            { "default": "query.mark_variant < 555 && query.mark_variant != 20" }
          ]
        },
        "battery_decrease_2": {
          "animations": ["battery_decrease_2"],
          "transitions": [
            { "battery_decrease_3": "q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_decrease3')" },
            { "battery_increase_2": "q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_increase2')" },
            { "default": "query.mark_variant < 555 && query.mark_variant != 20" }
          ]
        },
        "battery_decrease_3": {
          "animations": ["battery_decrease_3"],
          "transitions": [
            { "battery_decrease_4": "q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_decrease4')" },
            { "battery_increase_3": "q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_increase3')" },
            { "default": "query.mark_variant < 555 && query.mark_variant != 20" }
          ]
        },
        "battery_decrease_4": {
          "animations": ["battery_decrease_4"],
          "transitions": [
            { "battery_increase_4": "q.is_item_name_any('slot.armor.legs', 'ibexx_itc:battery_increase4')" },
            { "default": "query.mark_variant < 555 && query.mark_variant != 20" }
          ]
        }
      }
    }
  }
}