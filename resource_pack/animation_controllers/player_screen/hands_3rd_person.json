{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ibexx_itc.hands.3rd_person": {
      "states": {
          "default": {
              "transitions": [
              { "3rd_person_gun": "q.is_alive && query.is_item_name_any('slot.weapon.mainhand', 0, 'ibexx_itc:gun')" },
              { "3rd_person_knife": "q.is_alive && query.is_item_name_any('slot.weapon.mainhand', 0, 'ibexx_itc:knife')" },
              { "3rd_person_toxic_bomb": "q.is_alive && query.is_item_name_any('slot.weapon.mainhand', 0, 'ibexx_itc:toxic_bomb')" },
              { "3rd_person_kit": "q.is_alive && query.is_item_name_any('slot.weapon.mainhand', 0, 'ibexx_itc:kit')" },
              { "3rd_person_ammo": "q.is_alive && query.is_item_name_any('slot.weapon.mainhand', 0, 'ibexx_itc:ammo')" }
              ],
              "blend_transition": 0.3
          },
          "3rd_person_gun": {
            "animations": [
              "3rd_person_gun"
            ],
            "transitions": [
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'ibexx_itc:gun')" }
            ]
          },
          "3rd_person_knife": {
            "animations": [
              "3rd_person_knife"
            ],
            "transitions": [
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'ibexx_itc:knife')" }
            ]
          },
          "3rd_person_toxic_bomb": {
            "animations": [
              "3rd_person_toxic_bomb"
            ],
            "transitions": [
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'ibexx_itc:toxic_bomb')" }
            ]
          },
          "3rd_person_kit": {
            "animations": [
              "3rd_person_kit"
            ],
            "transitions": [
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'ibexx_itc:kit')" }
            ]
          },
          "3rd_person_ammo": {
            "animations": [
              "3rd_person_ammo"
            ],
            "transitions": [
              { "default": "!query.is_item_name_any('slot.weapon.mainhand', 0, 'ibexx_itc:ammo')" }
            ]
          }
      }
  }
  }
}
