{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.player.first_person": {
      "geometry": "Geometry.default",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Texture.default" ],
      "part_visibility": [
        { "*": false },
        { "rightArm": true },
        { "rightSleeve": true },
        { "rightItem": true },
        { "leftArm": true },
        { "leftSleeve": true }
      ]
    },

    "controller.render.static": {
      "arrays": {
        "textures": {
          "Array.StaticTextures": [
            "Texture.static_normal",
            "Texture.camera_no_signal",
            "Texture.static_1",
            "Texture.static_2",
            "Texture.static_3"
          ]
        }
      },
      "geometry": "Geometry.static",
      "materials": [ { "*": "Material.alphablend" } ],
      "textures": [
        "Array.StaticTextures[ query.mark_variant == 557 ? 1 : (query.mark_variant == 560 ? 2 : (query.mark_variant == 561 ? 3 : ((query.mark_variant == 562 || query.mark_variant == 20) ? 4 : 0))) ]"
      ]
    },

    "controller.render.turn_off_cam_warning": {
      "geometry": "Geometry.turn_off_cam_warning",
      "materials": [ { "*": "Material.alphatest" } ],
      "textures": [ "Texture.red_font" ],
      "part_visibility": [
        { "*": true },
        { "alphabet": false },
        { "punctuation": false },
        { "capitals": false }
      ]
    },

    "controller.render.player_battery": {
      "geometry": "Geometry.battery",
      "materials": [ { "*": "Material.alphatest" } ],
      "textures": [ "Texture.battery" ]
    },

    "controller.render.game_start_curtain": {
      "geometry": "Geometry.game_start_curtain",
      "materials": [ { "*": "Material.alphatest" } ],
      "textures": [ "Texture.white_font" ],
      "part_visibility": [
        { "*": "(query.mark_variant >= 553 && query.mark_variant <= 562)" }
      ]
    },

    "controller.render.game_over_scene": {
      "geometry": "Geometry.game_over_scene",
      "materials": [ { "*": "Material.alphatest" } ],
      "textures": [ "Texture.red_font" ],
      "part_visibility": [
        { "*": true },
        { "alphabet": false },
        { "punctuation": false },
        { "capitals": false }
      ]
    },

    "controller.render.new_game_started_dialog": {
      "geometry": "Geometry.new_game_started_dialog",
      "materials": [ { "*": "Material.alphatest" } ],
      "textures": [ "Texture.white_font" ],
      "part_visibility": [
        { "*": true },
        { "alphabet": false },
        { "punctuation": false },
        { "capitals": false }
      ]
    },

    "controller.render.round_completed_dialog": {
      "geometry": "geometry.round_completed_dialog",
      "materials": [ { "*": "Material.alphatest" } ],
      "textures": [ "Texture.white_font" ],
      "part_visibility": [
        { "*": true },
        { "alphabet": false },
        { "punctuation": false },
        { "capitals": false }
      ]
    }
  }
}
