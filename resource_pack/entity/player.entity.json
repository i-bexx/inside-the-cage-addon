{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:player",

      "materials": {
        "default": "entity_alphatest",
        "cape": "entity_alphatest",
        "animated": "player_animated",
        "spectator": "player_spectator",

        "alphatest": "entity_alphatest",
        "alphablend": "entity_alphablend",
        "armor_stand": "armor_stand"
      },

      "textures": {
        "default": "textures/entity/steve",
        "cape": "textures/entity/cape_invisible",

        "static_normal": "textures/entity/game/Static/static_1",
        "static_1": "textures/entity/game/Static/static_1",
        "static_2": "textures/entity/game/Static/static_2",
        "static_3": "textures/entity/game/Static/static_3",
        "camera_no_signal": "textures/entity/game/Static/camera_no_signal",

        "battery": "textures/entity/game/battery_player",
        "white_font": "textures/entity/game/Fonts/white_font",
        "red_font": "textures/entity/game/Fonts/red_font"
      },

      "geometry": {
        "default": "geometry.humanoid.custom",
        "cape": "geometry.cape",
        "static": "geometry.static",
        "battery": "geometry.battery_player",
        "game_start_curtain": "geometry.game_start_curtain",
        "new_game_started_dialog": "geometry.new_game_started_dialog",
        "round_completed_dialog": "geometry.round_completed_dialog",
        "game_over_scene": "geometry.game_over_scene",
        "turn_off_cam_warning": "geometry.turn_off_cam_warning"
      },

      "scripts": {
        "scale": "0.9375",
        "initialize": [
          "variable.is_holding_right = 0.0;",
          "variable.is_blinking = 0.0;",
          "variable.last_blink_time = 0.0;",
          "variable.hand_bob = 0.0;"
        ],

        "pre_animation": [
          "variable.helmet_layer_visible = 1.0;",
          "variable.leg_layer_visible = 1.0;",
          "variable.boot_layer_visible = 1.0;",
          "variable.chest_layer_visible = 1.0;",
          "variable.attack_body_rot_y = Math.sin(360*Math.sqrt(variable.attack_time)) * 5.0;",
          "variable.tcos0 = (math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
          "variable.first_person_rotation_factor = math.sin((1 - variable.attack_time) * 180.0);",
          "variable.hand_bob = query.life_time < 0.01 ? 0.0 : variable.hand_bob + ((query.is_on_ground && query.is_alive ? math.clamp(math.sqrt(math.pow(query.position_delta(0), 2.0) + math.pow(query.position_delta(2), 2.0)), 0.0, 0.1) : 0.0) - variable.hand_bob) * 0.02;",

          "variable.map_angle = math.clamp(1 - variable.player_x_rotation / 45.1, 0.0, 1.0);",
          "variable.item_use_normalized = query.main_hand_item_use_duration / query.main_hand_item_max_duration;",

          "variable.knife_attack_index = math.random(0, 1);",
          "variable.not_holding_special_items = query.is_alive && !query.is_item_name_any('slot.weapon.mainhand', 0, 'game:gun', 'game:knife', 'game:toxic_bomb', 'game:kit', 'game:ammo');"
        ],

        "animate": [
          { "root": "!variable.is_first_person" },
          
          { "hands_controller": "variable.is_first_person && (query.mark_variant == 0 || query.mark_variant == 553)" },
          { "hands_controller_3rd_person": "!variable.is_first_person && !variable.not_holding_special_items" },
          
          "camera_rec_controller",
          "camera_line_controller",
          "static_controller",
          "turn_off_cam_warning_controller",

          "new_game_started_controller",
          "game_start_curtain",
          "round_completed_dialog_controller",
          "game_over_scene",
          
          "batteryhud",
          "battery_static"

        ]
      },

      "animations": {
        "root": "controller.animation.player.root",

        "camera_rec_controller": "controller.animation.camera_rec",
        "camera_line_controller": "controller.animation.camera_line",
        "static_controller": "controller.animation.static",
        "camera_start_anim": "animation.camera.start",
        "camera_rec_normal": "animation.camera.rec_normal",
        "camera_rec_static": "animation.camera.rec_static",
        "camera_line_anim": "animation.camera.line",
        "static_anim": "animation.camera.static",
        "static_low_sanity_anim": "animation.camera.sanity_low_static",
        "static_back_to_normal_anim": "animation.camera.back_to_normal",
        "no_signal_anim": "animation.camera.no_signal",
        "initialization_before_locking_the_cam_anim": "animation.camera.initialization_before_locking_the_cam",

        "game_start_curtain": "controller.animation.game_start_curtain",
        "game_start_curtain_close_anim": "animation.curtain_close",
        "game_start_curtain_open_anim": "animation.curtain_open",

        "game_over_anim": "animation.game_over",
        "game_over_scene": "controller.animation.game_over",

        "new_game_started_dialog_anim": "animation.new_game_started.text",
        "new_game_started_spin_anim": "animation.new_game_started.spin",
        "new_game_started_controller": "controller.animation.new_game_started",

        "round_completed_dialog_controller": "controller.animation.round_completed_dialog",
        "round_completed_dialog_anim": "animation.round_completed_dialog",

        "turn_off_cam_warning_controller": "controller.animation.turn_off_cam_warning",
        "turn_off_cam_warning_anim": "animation.camera.turn_off_cam_warning",
        "turn_off_cam_warning_stop_anim": "animation.camera.turn_off_cam_warning_stop",

        "battery_decrease_1": "animation.battery.decrease_1",
        "battery_decrease_2": "animation.battery.decrease_2",
        "battery_decrease_3": "animation.battery.decrease_3",
        "battery_decrease_4": "animation.battery.decrease_4",

        "battery_increase_1": "animation.battery.increase_1",
        "battery_increase_2": "animation.battery.increase_2",
        "battery_increase_3": "animation.battery.increase_3",
        "battery_increase_4": "animation.battery.increase_4",

        "battery_static_anim": "animation.battery_player.static",
        "battery_static_stop_anim": "animation.battery_player.static_stop",

        "battery_is_critical_anim": "animation.battery_player.is_critical",

        "batteryhud": "controller.animation.battery",
        "battery_static": "controller.animation.battery_static",
        
        "hands_controller": "controller.animation.hand",
        "hands": "animation.hands.still",
        "attack": "animation.hands.attack",
        "swim": "animation.hands.swim",
        "run": "animation.hands.run",
        "walk": "animation.hands.walk",
        "move_right": "animation.hands.move_right",
        "move_left": "animation.hands.move_left",
        "still_left_arm": "animation.hands.still_left_arm",
        "still_right_arm": "animation.hands.still_right_arm",
        "despawn_right_but_left_not_empty": "animation.hands.despawn_right_but_left_not_empty",
        "despawn_left_but_right_not_empty": "animation.hands.despawn_left_but_right_not_empty",
        "despawn_right_but_left_empty": "animation.hands.despawn_right_but_left_empty",
        "despawn_left_but_right_empty": "animation.hands.despawn_left_but_right_empty",
        "respawn_right_but_left_empty": "animation.hands.respawn_right_but_left_empty",
        "respawn_left_but_right_empty": "animation.hands.respawn_left_but_right_empty",
        "respawn_right_but_left_not_empty": "animation.hands.respawn_right_but_left_not_empty",
        "respawn_left_but_right_not_empty": "animation.hands.respawn_left_but_right_not_empty",
        
        "starting_gun": "animation.hands.gun.start",
        "holding_gun": "animation.hands.gun.hold",
        "walking_gun": "animation.hands.gun.walk",
        "running_gun": "animation.hands.gun.run",
        "shooting_gun": "animation.hands.gun.shoot",
        "aiming_gun": "animation.hands.gun.aim",
        "aiming_gun_still": "animation.hands.gun.aim_still",
        "shoot_aiming": "animation.hands.gun.shoot_aiming",

        "starting_knife": "animation.hands.knife.start",
        "holding_knife": "animation.hands.knife.hold",
        "attacking_knife": "animation.hands.knife.attack",
        "attacking_knife2": "animation.hands.knife.attack2",
        "attack_finishing_knife": "animation.hands.knife.attack_finishing",

        "toxic_bomb_pick_up": "animation.hands.toxic_bomb_pick_up",
        "toxic_bomb_hold": "animation.hands.toxic_bomb_hold",
        "toxic_bomb_use": "animation.hands.toxic_bomb_use",

        "kit_pick_up": "animation.hands.kit.pick_up",
        "holding_kit": "animation.hands.kit.hold",

        "hands_controller_3rd_person": "controller.animation.hands.3rd_person",
        "3rd_person_gun": "animation.hands.3rd_person.gun",
        "3rd_person_knife": "animation.hands.3rd_person.knife",
        "3rd_person_toxic_bomb": "animation.hands.3rd_person.toxic_bomb",
        "3rd_person_kit": "animation.hands.3rd_person.kit"

      },

      "sound_effects": {
        "keyboard": "keyboard",
        "camera_shutter": "camera_shutter",
        "pick_up": "pick_up",
        "tractor_door": "tractor_door",
        "pistol_loading_chamber": "pistol_loading_chamber",
        "gun_shoot": "gun_shoot",
        "knife_draw": "knife_draw",
        "knife_whoosh": "knife_whoosh",
        "toxic_bomb_button": "toxic_bomb_button"
      },
           
      "render_controllers": [
        { "controller.render.player.first_person": "variable.is_first_person && !query.is_spectator && (query.mark_variant == 0 || query.mark_variant == 553 || !!variable.not_holding_special_items)" },
        { "controller.render.player.third_person": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator" },

        { "controller.render.player.first_person_spectator": "variable.is_first_person && query.is_spectator" },
        { "controller.render.player.third_person_spectator": "!variable.is_first_person && !variable.map_face_icon && query.is_spectator" },

        { "controller.render.static": "variable.is_first_person && (query.mark_variant >= 555 || query.mark_variant == 20)" },
        { "controller.render.turn_off_cam_warning": "variable.is_first_person && query.mark_variant >= 555 && query.is_item_name_any('slot.armor.chest', 0, 'game:turnoffcamwarning')"},
        { "controller.render.player_battery": "variable.is_first_person && (query.mark_variant >= 555 || query.mark_variant == 20)" },
        { "controller.render.new_game_started_dialog": "variable.is_first_person && (query.mark_variant == 1 || query.mark_variant == 2)" },
        { "controller.render.round_completed_dialog": "variable.is_first_person && query.mark_variant == 3" },
        { "controller.render.game_start_curtain": "variable.is_first_person && (query.mark_variant >= 553 && query.mark_variant <= 562)" },
        { "controller.render.game_over_scene": "variable.is_first_person && query.mark_variant == 20" }
      ],
      
      "enable_attachables": true
    }
  }
}
