{
  "namespace": "random_peep_anims",

  "entrance_animation_offset": {
    "anim_type": "offset",
    "easing": "in_out_expo",
    "duration": "$transition_time_push",
    "from": [ 0, "-5%" ],
    "to": [ 0, 0 ]
  },

  "entrance_animation_fade": {
    "anim_type": "alpha",
    "easing": "in_out_sine",
    "duration": "$transition_time_push",
    "from": 0.5,
    "to": 1.0
  }
}