{
  "format_version": "1.21.50",
  "minecraft:entity": {
    "description": {
      "identifier": "game:ghost",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,

      "spawn_category": "monster",
      
      "scripts": {
        "animate": [ "ghost_controller" ]
      },

      "animations": {
        "ghost_controller": "controller.animation.ghost",
        "ghost_just_spawned": "animation.ghost_just_spawned",
        "ghost_can_move": "animation.ghost_can_move"
      }
    },

    "component_groups": {
      "can_move": {
        "minecraft:movement": {
          "value": 0.23
        },
        "minecraft:behavior.look_at_player": {
          "priority": 8,
          "look_distance": 6,
          "probability": 0.02
        },
        "minecraft:behavior.random_look_around": {
          "priority": 9,
          "probability": 0.2
        },
        "minecraft:attack": {
          "damage": 3
        },
        "minecraft:behavior.melee_attack": {
          "priority": 3
        },
        "minecraft:behavior.random_stroll": {
          "priority": 7,
          "speed_multiplier": 1
        },
        "minecraft:behavior.hurt_by_target": {
          "priority": 1
        },
        "minecraft:ignore_cannot_be_attacked": {},
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": true,
          "reselect_targets": true,
          "within_radius": 25.0,
          "must_see_forget_duration": 17.0,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  { "test": "is_family", "subject": "other", "value": "player" }
                ]
              },
              "max_dist": 35
            }
          ]
        }
      },
      "ghost_dead": {
        "minecraft:transformation": {
          "add": {},
          "drop_equipment": false,
          "drop_inventory": false,
          "into": "game:ghost_dead",
          "keep_level": false,
          "keep_owner": false,
          "preserve_equipment": false,
          "delay": 0
        }
      },
      "despawn": {
        "minecraft:instant_despawn": {
          "remove_child_entities": true
        }
      }
    },

		"components": {
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                }
              ],
              "event": "bad_luck",
              "target": "other"
            }
          },
          {
            "cause": "lava",
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:environment_sensor": {
        "triggers": {
          "filters": {
            "test": "is_difficulty",
            "value": "peaceful"
          },
          "event": "despawn_event"
        }
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.9
      },
      "minecraft:health": {
        "value": 50,
        "max": 50
      },
      "minecraft:knockback_resistance": {
        "value": 100,
        "max": 100
      },
			"minecraft:type_family": {
				"family": [ "game", "monster", "mob" ]
			},

			"minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },

      "minecraft:movement.basic": {},

      "minecraft:movement": {
        "value": 0
      },
      "minecraft:navigation.walk": {
        "is_amphibious": true,
        "can_pass_doors": true,
        "can_walk": true,
        "can_break_doors": true
      },

      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:transient": {},
			"minecraft:physics": {}
		},

   "events": {
    "minecraft:entity_spawned": {
      "trigger": "spawn_event"
    },
    "minecraft:entity_transformed": {
      "trigger": "spawn_event"
    },
    "spawn_event": {
      "queue_command": {
        "command": [ "execute at @s run particle spawn:ghost ~ ~ ~", "execute at @s run playsound ghost_spawn @a[r=15] ~ ~ ~" ]
      }
    },
      "can_move_event": {
        "add": { "component_groups": [ "can_move" ] }
      },
      "ghost_dead_event": {
        "add": {
          "component_groups": [ "ghost_dead" ]
        }
      },
      "despawn_event": {
        "add": { "component_groups": [ "despawn" ] }
      }
    }
  }
}

