{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ghost": {
      "states": {
        "default": {
          "animations": [
            "ghost_just_spawned"
          ],
          "transitions": [
            { "can_move": "query.all_animations_finished" },
            { "dead": "!query.is_alive" }
          ]
        },
        "can_move": {
          "animations": [
            "ghost_can_move"
          ],
          "transitions": [
            { "dead": "!query.is_alive" }
          ]
        },
        "dead": {
          "on_entry": [ "@s ghost_dead_event" ]
        }
      }
  }
  }
}


